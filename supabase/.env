# Defaults for the env(MM_SMTP_*) values in config.toml. Committed on purpose: no secrets here.
# With these, the local stack keeps sending mail to the mail catcher (http://127.0.0.1:54324),
# which is what CI and a fresh checkout need — `supabase start` cannot read config.toml without
# a value for every env() it references.
#
# To deliver real email locally, put your own values in supabase/.env.local (gitignored, loaded
# after this file). See README "Real email in local development".
MM_SMTP_ENABLED=false
MM_SMTP_HOST=smtp.example.invalid
MM_SMTP_USER=unset
MM_SMTP_PASS=unset
MM_SMTP_ADMIN_EMAIL=noreply@example.invalid
