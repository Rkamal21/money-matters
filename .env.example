# Copy to .env and fill in from Supabase -> Project Settings -> API.
#
# Every variable here is VITE_-prefixed, which means Vite inlines it into the
# client bundle. Treat this file as the public-by-design list: if a value must
# stay secret it does not belong here, it belongs in an Edge Function.
# Validated at startup by src/config/env.ts, which refuses to start on a
# missing variable or on a service_role key in the anon slot.

# Required.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. With no DSN, Sentry is not initialised at all -- which is the normal
# state in local development, so a developer's own data never leaves the machine.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_APP_RELEASE=

# For local development, `npx supabase start` prints the URL and anon key to use.
